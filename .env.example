# Reference only — Deno Edge Functions don't read this file at runtime.
# Real values are set as Supabase secrets: `supabase secrets set KEY=value`
# (see DEPLOYMENT.md). Never commit real values here or anywhere else.

# ---- Read.ai OAuth 2.1 (scaffold — client_id/secret don't exist yet) ----
# The OAuth app's own identity, registered with Read.ai. Infrastructure-
# level, like GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET — not a per-user
# credential.
READ_AI_CLIENT_ID=
READ_AI_CLIENT_SECRET=

# Must exactly match what's registered as the redirect URI in Read.ai's
# OAuth app config. By convention (matching gmail-oauth-callback), set
# this to: {SUPABASE_URL}/functions/v1/read-ai-oauth-callback
READ_AI_REDIRECT_URI=

# Read.ai's OAuth authorize/token endpoints. Unverified placeholders —
# read-ai-authorize and read-ai-oauth-callback will throw a clear
# "not configured" error until these are set to real values.
READ_AI_AUTH_URL=
READ_AI_TOKEN_URL=

# Base URL for Read.ai's REST API. Used by _shared/readAiClient.ts's
# getMeetingSummary() stub, which also still has a TODO placeholder path
# appended to whatever this is set to — see that file.
READ_AI_API_BASE_URL=
